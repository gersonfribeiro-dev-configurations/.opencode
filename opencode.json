{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.agents/skills"
    ]
  },
  "mcp": {
    "pencil": {
      "type": "local",
      "command": [
        "~/.tools/pencil-mcp.bat",
        "--app",
        "desktop", // "visual_studio_code",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:API_KEY_CONTEXT7}"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "all",
        "X-MCP-Insiders": "true"
      }
    },
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--profile",
        "{env:PROFILE_TOOLKIT}"
      ],
      "enabled": true
    }
  }
}