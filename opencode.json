{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "instructions": [
    "{env:USERPROFILE}\\.agents\\AGENTS.md"
  ],
  "skills": {
    "paths": [
      "{env:USERPROFILE}\\.agents\\skills"
    ]
  },
  "mcp": {
    "pencil": {
      "type": "local",
      "command": [
        "{env:USERPROFILE}\\.tools\\pencil-mcp.bat",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--profile",
        "developer_boilerplate_mcp"
      ],
      "enabled": true
    }
  }
}